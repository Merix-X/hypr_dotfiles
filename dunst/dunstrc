[global]
    width = 300
    height = 100
    offset = 30x30
    origin = top-right
    transparency = 10
    frame_color = "#cba6f7" # Fialová (Mauve)
    font = JetBrainsMono Nerd Font 10

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    border_color = "#cba6f7"

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8" # Červená
    frame_color = "#f38ba8"
