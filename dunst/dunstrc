[global]
    font = JetBrainsMono Nerd Font 10
    corner_radius = 6
    width = (300, 420)
    height = 150
    offset = 12x12
    origin = top-right
    notification_limit = 5
    frame_width = 2
    separator_height = 2
    padding = 10
    horizontal_padding = 12
    progress_bar_height = 8

[urgency_low]
    background = "#101010"
    foreground = "#716e61"
    frame_color = "#2a2827"
    timeout = 4

[urgency_normal]
    background = "#0e0e10"
    foreground = "#e2d9b5"
    frame_color = "#ff0055"
    timeout = 5

[urgency_critical]
    background = "#0e0e10"
    foreground = "#e2d9b5"
    frame_color = "#8b001e"
    timeout = 0
