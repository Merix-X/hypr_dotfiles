[global]
    font = JetBrainsMono Nerd Font 10
    corner_radius = 6
    width = (300, 420)
    height = 150
    offset = 12x12
    origin = top-right
    notification_limit = 5
    frame_width = 2
    separator_height = 2
    padding = 10
    horizontal_padding = 12
    progress_bar_height = 8

[urgency_low]
    background = "#101010"
    foreground = "#716e61"
    frame_color = "#2a2827"
    timeout = 4

[urgency_normal]
    background = "#101010"
    foreground = "#c8c093"
    frame_color = "#ff9e3b"
    timeout = 6

[urgency_critical]
    background = "#101010"
    foreground = "#ff9e3b"
    frame_color = "#ff9e3b"
    timeout = 0
